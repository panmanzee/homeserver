# copy to .env (chmod 600). Real values are generated on the server; never commit .env
FREQTRADE__API_SERVER__USERNAME=changeme
FREQTRADE__API_SERVER__PASSWORD=changeme
FREQTRADE__API_SERVER__JWT_SECRET_KEY=changeme
FREQTRADE__API_SERVER__WS_TOKEN=changeme
# TrendSimple (no Jev) or TrendSimpleJev
BOT_STRATEGY=TrendSimple
