# Copy to .env and fill in.  docker compose reads .env automatically.

# Postgres password (must match the value the postgres volume was created with).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Shared secret between n8n and newsfeed-api (sent as the X-API-Key header).
# Generate one:  openssl rand -hex 32
SERVICE_API_KEY=change-me-to-a-long-random-string

# LLM for news enrichment: gemini (free tier, default) | anthropic
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest
# only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Stock prices. Free key from https://twelvedata.com/ (800 req/day, 8/min).
PRICE_PROVIDER=twelvedata
TWELVEDATA_API_KEY=your-twelvedata-key

# Telegram delivery. Token from @BotFather; chat id from
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"  (after you DM the bot)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=

# Optional overrides
PROMPT_VERSION=v4

# --- taskbot -------------------------------------------------------------
# Reuses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / SERVICE_API_KEY / GEMINI_API_KEY
# and LLM_PROVIDER above. taskbot uses its own Gemini model (flash-lite, for the
# high free-tier request/day cap); override with TASKBOT_GEMINI_MODEL.
# Set LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY to use Claude instead.
TASKBOT_TZ=Asia/Bangkok
# TASKBOT_GEMINI_MODEL=gemini-3.1-flash-lite
TASKBOT_MORNING_TIME=07:30
TASKBOT_EVENING_TIME=21:00
# Google Calendar mirror (optional — taskbot works without it). See taskbot/README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- vaultwarden -------------------------------------------------------
# DOMAIN must equal the `tailscale serve` host that fronts it (https, tailnet-only).
VAULTWARDEN_DOMAIN=https://<your-host>.<tailnet>.ts.net
# Set true to register the first account, then set false and `docker compose up -d vaultwarden`.
VAULTWARDEN_SIGNUPS_ALLOWED=false

# --- rag-api (study Q&A) ---------------------------------------------
# Ask questions about your own PDFs/notes. Reuses GEMINI_API_KEY and
# SERVICE_API_KEY above (SERVICE_API_KEY gates POST /ingest). Drop study
# files into rag-api/corpus/ then POST /ingest. See rag-api/README.md for
# the full RAG_* knob list (chunk size, candidates, retrieve-k, rrf-k0).
RAG_GEN_MODEL=gemini-3.1-flash-lite
RAG_EMBED_MODEL=gemini-embedding-001
RAG_MAX_QUESTIONS_PER_DAY=200

# --- uptime-kuma / actual / adguard ---------------------------------
# No env needed — all three are configured in their own web UIs on first run.
#   uptime-kuma : https://<host>.ts.net:8445   (create admin, add monitors, Telegram notify)
#   adguard     : https://<host>.ts.net:8446   (setup wizard: admin web port = 3000, DNS on :53)
#   actual      : https://<host>.ts.net:8447   (set a server password, create a budget file)
# AdGuard's DNS listener binds ONLY to the Tailscale IP (see docker-compose.yml).

# --- off-box backups (rclone) --------------------------------------
# scripts/backup.sh copies each archive to an rclone remote if one is set up.
# Backblaze B2 (10 GB free): make a private bucket + an app key, then:
#   rclone config create b2 b2 account <KEY_ID> key <APP_KEY>
# and set RCLONE_BUCKET in the crontab line (or a wrapper script).
# RCLONE_BUCKET=your-bucket-name
