# append to /etc/network/interfaces on the Proxmox host, then ifreload -a
# vmbr2: internal VLAN-aware bridge, no physical port, guests get a tag (net0 ...,tag=20)

auto vmbr2
iface vmbr2 inet manual
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 10 20 30 99

auto vmbr2.10
iface vmbr2.10 inet static
	address 10.10.10.1/24
	# MGMT

auto vmbr2.20
iface vmbr2.20 inet static
	address 10.10.20.1/24
	# SERVERS

auto vmbr2.30
iface vmbr2.30 inet static
	address 10.10.30.1/24
	# DMZ

auto vmbr2.99
iface vmbr2.99 inet static
	address 10.10.99.1/24
	# LAB

# routing between zones is done by nftables (zones.nft), needs net.ipv4.ip_forward=1
