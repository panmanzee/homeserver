# Copy to .env and fill in.  docker compose reads .env automatically.

# Postgres password (must match the value the postgres volume was created with).
POSTGRES_PASSWORD=REDACTED

# Shared secret between n8n and newsfeed-api (sent as the X-API-Key header).
# Generate one:  openssl rand -hex 32
SERVICE_API_KEY=change-me-to-a-long-random-string

# LLM for news enrichment: gemini (free tier, default) | anthropic
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest
# only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Stock prices. Free key from https://twelvedata.com/ (800 req/day, 8/min).
PRICE_PROVIDER=twelvedata
TWELVEDATA_API_KEY=your-twelvedata-key

# Telegram delivery. Token from @BotFather; chat id from
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"  (after you DM the bot)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=

# Optional overrides
PROMPT_VERSION=v4
